{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/((?!api/|assets/|sitemap\\.xml$|robots\\.txt$).*)",
      "destination": "/index.html"
    }
  ]
}
